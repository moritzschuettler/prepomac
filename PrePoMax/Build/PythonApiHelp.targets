<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PythonApiHelpSource>$(MSBuildProjectDirectory)\..\Python_API_Overview.md</PythonApiHelpSource>
    <PythonApiHelpStyle>$(MSBuildProjectDirectory)\Help\Python\Python_API_Overview.css</PythonApiHelpStyle>
    <PythonApiHelpOutput>$(TargetDir)Help\Python\Python_API_Overview.html</PythonApiHelpOutput>
    <PythonApiHelpMarkdigPackage>$(MSBuildProjectDirectory)\..\packages\Markdig.1.3.2</PythonApiHelpMarkdigPackage>
    <PythonApiHelpMarkdigAssembly>$(PythonApiHelpMarkdigPackage)\lib\netstandard2.0\Markdig.dll</PythonApiHelpMarkdigAssembly>
  </PropertyGroup>

  <UsingTask TaskName="GeneratePythonApiHelpHtml"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SourcePath ParameterType="System.String" Required="true" />
      <StylePath ParameterType="System.String" Required="true" />
      <OutputPath ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Reference Include="$(PythonApiHelpMarkdigAssembly)" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Using Namespace="Markdig" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        string markdown = File.ReadAllText(SourcePath, Encoding.UTF8);
        string css = File.ReadAllText(StylePath, Encoding.UTF8);
        MarkdownPipeline pipeline = new MarkdownPipelineBuilder().UseAdvancedExtensions().Build();
        string body = Markdown.ToHtml(markdown, pipeline);
        string html = "<!DOCTYPE html>\n" +
                      "<html lang=\"en\">\n" +
                      "<head>\n" +
                      "  <meta charset=\"utf-8\">\n" +
                      "  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n" +
                      "  <title>PrePoMax Python API Overview</title>\n" +
                      "  <style>\n" + css + "\n  </style>\n" +
                      "</head>\n" +
                      "<body>\n" +
                      "  <main class=\"markdown-body\">\n" + body +
                      "  </main>\n" +
                      "</body>\n" +
                      "</html>\n";
        string outputDirectory = Path.GetDirectoryName(OutputPath);
        Directory.CreateDirectory(outputDirectory);
        File.WriteAllText(OutputPath, html, new UTF8Encoding(false));
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="GeneratePythonApiHelp"
          AfterTargets="Build"
          Inputs="$(PythonApiHelpSource);$(PythonApiHelpStyle);$(MSBuildThisFileFullPath)"
          Outputs="$(PythonApiHelpOutput)">
    <GeneratePythonApiHelpHtml SourcePath="$(PythonApiHelpSource)"
                               StylePath="$(PythonApiHelpStyle)"
                               OutputPath="$(PythonApiHelpOutput)" />
  </Target>
</Project>
