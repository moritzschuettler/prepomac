rd /s /q "de" "en" "es" "fr" "hu" "it" "ja" "pt" "ru" "sk" "sv" "tr" "zh-cn" "zh-tw"

IF NOT EXIST "$(TargetDir)lib\" mkdir "$(TargetDir)lib\"

rem NetGenMesher runtime is vendored in ThirdParty (trimmed set: 1 exe + 37 dlls)
rem /PURGE removes binaries dropped from the vendored set; the file filters keep the license texts
IF NOT EXIST "$(TargetDir)Meshers\Netgen\" mkdir "$(TargetDir)Meshers\Netgen\"
robocopy "$(SolutionDir)ThirdParty\netgen" "$(TargetDir)Meshers\Netgen" *.exe *.dll /PURGE /NJH /NJS /NDL /NFL /NP
IF %ERRORLEVEL% GEQ 8 EXIT 1
VER > NUL

rem Gmsh runtime dll is vendored in ThirdParty - the sdk it comes from is what GmshCommon links against
copy "$(SolutionDir)ThirdParty\gmsh-4.13.0-Windows64-sdk\lib\gmsh-4.13.dll" "$(TargetDir)lib\gmsh-4.13.dll"

rem Mmg binaries are vendored in ThirdParty so a build produces a working Meshers\Mmg
IF NOT EXIST "$(TargetDir)Meshers\Mmg\" mkdir "$(TargetDir)Meshers\Mmg\"
copy "$(SolutionDir)ThirdParty\mmg\mmgs.exe" "$(TargetDir)Meshers\Mmg\mmgs.exe"
copy "$(SolutionDir)ThirdParty\mmg\mmg3d.exe" "$(TargetDir)Meshers\Mmg\mmg3d.exe"
copy "$(SolutionDir)ThirdParty\mmg\vcruntime140.dll" "$(TargetDir)Meshers\Mmg\vcruntime140.dll"

rem QuadWild-BiMDF runtime is vendored in ThirdParty; keep config paths relative to its executables
IF NOT EXIST "$(TargetDir)Meshers\QuadWild\" mkdir "$(TargetDir)Meshers\QuadWild\"
copy "$(SolutionDir)ThirdParty\quadwild-bimdf\quadwild.exe" "$(TargetDir)Meshers\QuadWild\quadwild.exe"
copy "$(SolutionDir)ThirdParty\quadwild-bimdf\quad_from_patches.exe" "$(TargetDir)Meshers\QuadWild\quad_from_patches.exe"
copy "$(SolutionDir)ThirdParty\quadwild-bimdf\README_release.md" "$(TargetDir)Meshers\QuadWild\README_release.md"
xcopy /D /Y /I /E "$(SolutionDir)ThirdParty\quadwild-bimdf\config" "$(TargetDir)Meshers\QuadWild\config"

rem License texts that must travel with the distributed binaries
copy "$(SolutionDir)LICENSE" "$(TargetDir)LICENSE"
IF EXIST "$(TargetDir)lib\gmsh-*.dll" copy "$(SolutionDir)Licenses\gmsh\LICENSE.txt" "$(TargetDir)lib\gmsh-LICENSE.txt"
IF EXIST "$(TargetDir)lib\gmsh-*.dll" copy "$(SolutionDir)Licenses\gmsh\CREDITS.txt" "$(TargetDir)lib\gmsh-CREDITS.txt"
IF EXIST "$(TargetDir)Meshers\Mmg\mmgs.exe" copy "$(SolutionDir)Licenses\mmg\LICENSE" "$(TargetDir)Meshers\Mmg\LICENSE"
IF EXIST "$(TargetDir)Meshers\Mmg\mmgs.exe" copy "$(SolutionDir)Licenses\mmg\COPYING.LESSER" "$(TargetDir)Meshers\Mmg\COPYING.LESSER"
IF EXIST "$(TargetDir)Meshers\Mmg\mmgs.exe" copy "$(SolutionDir)Licenses\mmg\COPYING" "$(TargetDir)Meshers\Mmg\COPYING"
IF EXIST "$(TargetDir)Meshers\QuadWild\quadwild.exe" copy "$(SolutionDir)Licenses\quadwild\LICENSE" "$(TargetDir)Meshers\QuadWild\LICENSE"
IF EXIST "$(TargetDir)Meshers\QuadWild\quadwild.exe" copy "$(SolutionDir)Licenses\quadwild\NOTICE.md" "$(TargetDir)Meshers\QuadWild\NOTICE.md"
IF EXIST "$(TargetDir)Meshers\Netgen\NetGenMesher.exe" copy "$(SolutionDir)Licenses\netgen\NOTICE.md" "$(TargetDir)Meshers\Netgen\NOTICE.md"
IF EXIST "$(TargetDir)Meshers\Netgen\NetGenMesher.exe" copy "$(SolutionDir)Licenses\netgen\LGPL-2.1.txt" "$(TargetDir)Meshers\Netgen\LGPL-2.1.txt"
