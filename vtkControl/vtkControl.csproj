  <!-- vtkNative: the native VTK 9.7 library, built with CMake before this project. The post build event of PrePoMax
       copies vtkNative\build\runtime into the lib folder. VtkNativeVtkDir defaults to the prebuilt VTK SDK, which is
       downloaded from VtkNativeSdkUrl into vtkNative\sdk on the first build; set it (e.g. as an environment
       variable) to use a local VTK build instead. CMake defaults to the one installed with Visual Studio.
       Set VtkNativeSkipBuild=true to skip. -->
  <PropertyGroup>
    <VtkNativeCMake Condition="'$(VtkNativeCMake)' == '' And Exists('$(VsInstallRoot)\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe')">$(VsInstallRoot)\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe</VtkNativeCMake>
    <VtkNativeCMake Condition="'$(VtkNativeCMake)' == ''">C:\Program Files\CMake\bin\cmake.exe</VtkNativeCMake>
    <VtkNativeSourceDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\vtkNative'))</VtkNativeSourceDir>
    <VtkNativeBuildDir>$(VtkNativeSourceDir)\build</VtkNativeBuildDir>
    <VtkNativeSdkName>vtk-9.7.1-pmx1-win-x64</VtkNativeSdkName>
    <VtkNativeSdkUrl Condition="'$(VtkNativeSdkUrl)' == ''">https://github.com/PrePoMax/PrePoMax/releases/download/vtk-sdk-9.7.1-pmx1/$(VtkNativeSdkName).zip</VtkNativeSdkUrl>
    <VtkNativeSdkDir>$(VtkNativeSourceDir)\sdk\$(VtkNativeSdkName)</VtkNativeSdkDir>
    <VtkNativeSdkVtkDir>$(VtkNativeSdkDir)\lib\cmake\vtk-9.7</VtkNativeSdkVtkDir>
    <VtkNativeVtkDir Condition="'$(VtkNativeVtkDir)' == ''">$(VtkNativeSdkVtkDir)</VtkNativeVtkDir>
    <VtkNativeConfigureStamp>$(VtkNativeBuildDir)\vtkNative.configure.txt</VtkNativeConfigureStamp>
    <VtkNativeConfiguration>$(VtkNativeCMake)|$(VtkNativeVtkDir)</VtkNativeConfiguration>
  </PropertyGroup>
  <Target Name="DownloadVtkNativeSdk" Condition="'$(VtkNativeSkipBuild)' != 'true' And '$(VtkNativeVtkDir)' == '$(VtkNativeSdkVtkDir)' And !Exists('$(VtkNativeSdkDir)\sdk.complete')">
    <Message Importance="high" Text="vtkNative: downloading the VTK SDK from $(VtkNativeSdkUrl)" />
    <RemoveDir Directories="$(VtkNativeSdkDir)" />
    <DownloadFile SourceUrl="$(VtkNativeSdkUrl)" DestinationFolder="$(VtkNativeSourceDir)\sdk" DestinationFileName="$(VtkNativeSdkName).zip" Retries="2" />
    <Unzip SourceFiles="$(VtkNativeSourceDir)\sdk\$(VtkNativeSdkName).zip" DestinationFolder="$(VtkNativeSdkDir)" />
    <Delete Files="$(VtkNativeSourceDir)\sdk\$(VtkNativeSdkName).zip" />
    <Touch Files="$(VtkNativeSdkDir)\sdk.complete" AlwaysCreate="true" />
  </Target>
  <Target Name="BuildVtkNative" BeforeTargets="BeforeBuild" DependsOnTargets="DownloadVtkNativeSdk" Condition="'$(VtkNativeSkipBuild)' != 'true'">
    <Error Condition="!Exists('$(VtkNativeCMake)')" Text="vtkNative cannot be built: CMake was not found at $(VtkNativeCMake). Install the 'C++ CMake tools for Windows' component of Visual Studio, or set VtkNativeCMake." />
    <Error Condition="!Exists('$(VtkNativeVtkDir)\vtk-config.cmake')" Text="vtkNative cannot be built: VTK 9.7 was not found at $(VtkNativeVtkDir)." />
    <ReadLinesFromFile Condition="Exists('$(VtkNativeConfigureStamp)')" File="$(VtkNativeConfigureStamp)">
      <Output TaskParameter="Lines" PropertyName="VtkNativeConfiguredWith" />
    </ReadLinesFromFile>
    <RemoveDir Condition="'$(VtkNativeConfiguredWith)' != '$(VtkNativeConfiguration)'" Directories="$(VtkNativeBuildDir)" />
    <Exec Condition="'$(VtkNativeConfiguredWith)' != '$(VtkNativeConfiguration)'" Command="&quot;$(VtkNativeCMake)&quot; -S &quot;$(VtkNativeSourceDir)&quot; -B &quot;$(VtkNativeBuildDir)&quot; -A x64 &quot;-DVTK_DIR=$(VtkNativeVtkDir)&quot;" />
    <WriteLinesToFile Condition="'$(VtkNativeConfiguredWith)' != '$(VtkNativeConfiguration)'" File="$(VtkNativeConfigureStamp)" Lines="$(VtkNativeConfiguration)" Overwrite="true" />
    <Exec Command="&quot;$(VtkNativeCMake)&quot; --build &quot;$(VtkNativeBuildDir)&quot; --config Release -- -nologo -v:minimal" />
  </Target>
